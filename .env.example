VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OAuth Client ID from Google Cloud Console (safe to expose client-side —
# it's a public identifier, not a secret). The matching Client Secret is
# NOT an env var here — it's a Supabase Edge Function secret only
# (google-oauth-exchange / google-calendar-events), never bundled into the
# frontend.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
